# 虚拟环境（容器内用 pip 重装，不打包本地 venv）
venv/
.venv/

# Python 缓存（容器内会重新生成）
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# 环境变量（含真实 API Key，绝对不打包进镜像）
.env

# 上传的论文文件（通过 volume 挂载，不打包进镜像）
uploads/
*.pdf
*.faiss
*.pkl

# 开发工具
.git/
.gitignore
.idea/
.vscode/
*.DS_Store

# 文档和计划（不影响运行）
*.md
设计.md
开发.md
日志.md
.claude/
