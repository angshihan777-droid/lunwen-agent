# Copy this file to .env for local development.
# You can also enter API keys from the web UI after the service starts.

# OpenAI / OpenAI-compatible providers
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Tavily web search
TAVILY_API_KEY=tvly-...

# Default LLM settings
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
